{
  "opencollection": "1.0.0",
  "info": {
    "name": "TD SYNNEX StreamOne Ion Authentication Cloud Providers API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cloud Providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
