{
  "opencollection": "1.0.0",
  "info": {
    "name": "TD SYNNEX StreamOne Ion Authentication API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate OAuth Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ion.tdsynnex.com/api/oauth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange a refresh token for an OAuth 2.0 bearer access token. Access tokens expire after 7200 seconds (2 hours). Refresh tokens are valid for 32 days and are single-use."
        }
      ]
    }
  ],
  "bundled": true
}